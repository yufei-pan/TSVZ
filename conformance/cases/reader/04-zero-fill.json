{"format": 1, "class": "reader", "cases": [
{"id": "4.9-zero-fill-before-a-record-is-recovered", "spec": ["4.9", "4.10"], "level": "MUST",
 "note": "Zero bytes left by a crash before an appended record are dropped under the default recover policy.",
 "files": {"s.tsvz": "a\t1\n\u0000\u0000\u0000\u0000c\t3\n"},
 "expect": {"read": [["a", "1"], ["c", "3"]], "len": 2}},
{"id": "4.9-zero-fill-inside-a-line-keeps-what-follows", "spec": ["4.9", "4.10"], "level": "MUST",
 "note": "Only the bytes after the last zero byte of a damaged line are read.",
 "files": {"s.tsvz": "a\t1\nb\t2\u0000\u0000\u0000x\t9\n"},
 "expect": {"read": [["a", "1"], ["x", "9"]], "len": 2}},
{"id": "4.9-zero-fill-in-psvz", "spec": ["4.9", "2.1"], "level": "MUST",
 "note": "In .psvz too a zero byte in a record is damage.",
 "store": "s.psvz", "files": {"s.psvz": "a|1\n\u0000\u0000c|3\n"},
 "expect": {"read": [["a", "1"], ["c", "3"]], "len": 2}},
{"id": "4.9-nsvz-has-no-zero-fill-damage", "spec": ["4.9", "7.7"], "level": "MUST",
 "note": "In .nsvz the zero byte is the delimiter: a line starting with one is an empty-key row, ignored, never damage.",
 "store": "s.nsvz", "files": {"s.nsvz": "a\u00001\n\u0000x\n\u0000\u0000\u0000c\u00003\n"},
 "expect": {"read": [["a", "1"]], "len": 1}},
{"id": "4.9-nsvz-zeros-inside-a-line-are-delimiters", "spec": ["4.9", "5.1", "9.2"], "level": "MUST",
 "note": "In .nsvz zero bytes after the key are delimiters, as always.",
 "store": "s.nsvz", "files": {"s.nsvz": "a\u0000\u0000b\n"},
 "expect": {"read": [["a", "", "b"]], "len": 1}},
{"id": "4.10-skip-ignores-a-zero-filled-line", "spec": ["4.10", "4.9"], "level": "MUST",
 "note": "Under skip a damaged line is ignored.",
 "files": {"s.tsvz": "#_on_corruption_#\tskip\na\t1\n\u0000\u0000c\t3\nd\t4\n"},
 "expect": {"read": [["a", "1"], ["d", "4"]], "len": 2}},
{"id": "4.10-stop-ends-the-read", "spec": ["4.10", "20.6"], "level": "MUST",
 "note": "Under stop nothing after the damage is read, and the read fails.",
 "files": {"s.tsvz": "#_on_corruption_#\tstop\na\t1\n\u0000\u0000c\t3\nd\t4\n"},
 "expect": {"read": {"rows": [["a", "1"]], "exit": 1}}},
{"id": "4.10-stop-hides-later-parts", "spec": ["4.10", "17.4"], "level": "MUST",
 "note": "Under stop the read ends for the whole store: later parts are not read. Policy values ignore ASCII case.",
 "files": {"s.tsvz": "#_on_corruption_#\tSTOP\na\t1\n\u0000x\t1\n", "s.tsvz.1": "b\t2\n"},
 "expect": {"read": {"rows": [["a", "1"]], "exit": 1}}},
{"id": "4.10-invalid-policy-is-ignored", "spec": ["4.10", "12.4.5"], "level": "MUST",
 "note": "An invalid #_on_corruption_# value is ignored: the default recover applies.",
 "files": {"s.tsvz": "#_on_corruption_#\tmaybe\na\t1\n\u0000\u0000c\t3\n"},
 "expect": {"read": [["a", "1"], ["c", "3"]], "len": 2}},
{"id": "4.10-the-policy-in-force-at-the-damage-decides", "spec": ["4.10", "12.1"], "level": "MUST",
 "note": "The policy is a stateful marker: the value in force when the damage is met applies.",
 "files": {"s.tsvz": "#_on_corruption_#\tskip\na\t1\n#_on_corruption_#\t\n\u0000\u0000c\t3\n"},
 "expect": {"read": [["a", "1"], ["c", "3"]], "len": 2}}
]}
